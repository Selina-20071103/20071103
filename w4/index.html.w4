<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>朋友對我的動態留言板 🌸</title>
  
  <!-- 引入 Google 可愛風格字體 (Comic Neue + Noto Sans TC) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Comic+Neue:wght@700&family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet">

  <style>
    /* =========================================================
       1. 全域風格設定 (可在此修改背景色、全域字型)
       ========================================================= */
    :root {
      /* 【顏色控制區】 */
      --bg-color: #FFF5F7;          /* 網頁背景色 (溫柔粉白) */
      --card-bg: #FFFFFF;           /* 卡片背景色 */
      --title-color: #FF7B9C;       /* 主標題顏色 */
      --text-color: #5A4A42;        /* 主要文字顏色 (溫柔奶茶棕) */
      --name-color: #FF6B8B;        /* 留言者名字顏色 */
      --shadow-color: rgba(255, 182, 193, 0.4); /* 卡片陰影顏色 */
      
      /* 【高亮/輪播特效顏色控制】 */
      --highlight-border: #FF69B4;  /* 被選中卡片的邊框顏色 (熱情粉紅) */
      --highlight-glow: rgba(255, 105, 180, 0.6); /* 被選中卡片的發光顏色 */

      /* 【輪播秒數控制】注意：JavaScript 中的秒數也要同步修改！ */
      --carousel-duration: 3s;       /* 輪播切換的動畫過渡時間 */
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      font-family: 'Comic Neue', 'Noto Sans TC', sans-serif;
      color: var(--text-color);
      padding: 20px;
      min-height: 100vh;
      /* 背景加上可愛的小圓點點陣圖案 */
      background-image: radial-gradient(#FFD1DC 15%, transparent 16%);
      background-size: 30px 30px;
    }

    /* 頁面標題區 */
    header {
      text-align: center;
      margin-bottom: 30px;
    }

    header h1 {
      font-size: 2.2rem;
      color: var(--title-color);
      text-shadow: 2px 2px 0px #FFF;
      display: inline-block;
      background: #FFF;
      padding: 10px 25px;
      border-radius: 50px;
      box-shadow: 0 4px 15px var(--shadow-color);
    }

    /* =========================================================
       2. 載入中動畫設定 (Loading Animation)
       ========================================================= */
    #loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 50px 0;
    }

    /* 跳動的可愛可愛圓球 */
    .loader-dots {
      display: flex;
      gap: 12px;
      margin-bottom: 15px;
    }

    .loader-dots div {
      width: 18px;
      height: 18px;
      background-color: var(--title-color);
      border-radius: 50%;
      animation: bounce 0.6s infinite alternate;
    }

    .loader-dots div:nth-child(2) { animation-delay: 0.2s; background-color: #FFB6C1; }
    .loader-dots div:nth-child(3) { animation-delay: 0.4s; background-color: #FFD700; }

    @keyframes bounce {
      to {
        transform: translateY(-15px) scale(1.2);
      }
    }

    #loading p {
      font-weight: bold;
      color: var(--title-color);
      font-size: 1.2rem;
      letter-spacing: 1px;
    }

    /* =========================================================
       3. 瀑布流排版 (Masonry Layout)
       ========================================================= */
    .masonry-container {
      /* 使用 CSS column 實現瀑布流 */
      column-count: 4;              /* 預設 4 欄 (可依需求調整) */
      column-gap: 20px;
      max-width: 1200px;
      margin: 0 auto;
    }

    /* 響應式切換：畫面變小時減少欄位 */
    @media (max-width: 1024px) { .masonry-container { column-count: 3; } }
    @media (max-width: 768px)  { .masonry-container { column-count: 2; } }
    @media (max-width: 480px)  { .masonry-container { column-count: 1; } }

    /* =========================================================
       4. 留言卡片基礎與動畫設定
       ========================================================= */
    .card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 20px;
      margin-bottom: 20px;
      break-inside: avoid;          /* 避免卡片在 column 跨頁切割 */
      box-shadow: 0 8px 20px var(--shadow-color);
      border: 3px solid transparent;/* 預留邊框，避免亮起時卡片抖動 */
      transition: all 0.5s ease;    /* 平滑過渡動畫 */
      position: relative;
      cursor: pointer;
    }

    /* 卡片頂部可愛的紙張釘子或拍立得裝飾圖示 */
    .card::before {
      content: '🌸';
      position: absolute;
      top: -12px;
      right: 15px;
      font-size: 1.2rem;
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      border-bottom: 2px dashed #FFE4E1;
      padding-bottom: 8px;
    }

    .card-name {
      font-weight: bold;
      font-size: 1.1rem;
      color: var(--name-color);
    }

    .card-time {
      font-size: 0.75rem;
      color: #AAA;
    }

    .card-content {
      font-size: 0.95rem;
      line-height: 1.6;
      word-wrap: break-word;        /* 避免長英文/網址破壞卡片 */
      white-space: pre-wrap;        /* 保留留言者發文時的換行 */
    }

    /* =========================================================
       5. 輪播焦點 (Highlight) 特效
       ========================================================= */
    
    /* 1. 當前被選中的卡片：放大 + 發光 + 彩色邊框 */
    .card.highlight {
      transform: scale(1.08) translateY(-5px);
      z-index: 10;                  /* 確保放大時疊在最上層 */
      border-color: var(--highlight-border);
      box-shadow: 0 12px 30px var(--highlight-glow);
      filter: blur(0px) brightness(1.05);
      opacity: 1;
    }

    /* 2. 其他沒被選中的卡片：變暗 + 微微模糊 */
    .masonry-container.has-highlight .card:not(.highlight) {
      opacity: 0.5;                  /* 降低透明度 */
      filter: blur(1.5px) grayscale(20%); /* 增加些微模糊與灰階 */
      transform: scale(0.96);
    }
  </style>
</head>
<body>

  <header>
    <h1>💌 朋友對我的動態留言板 💌</h1>
  </header>

  <!-- 讀取中動畫 (JavaScript 載入完成後會隱藏) -->
  <div id="loading">
    <div class="loader-dots">
      <div></div>
      <div></div>
      <div></div>
    </div>
    <p>讀取留言中... ✨</p>
  </div>

  <!-- 瀑布流留言牆容器 -->
  <div id="masonry-wall" class="masonry-container"></div>

  <script>
    /* =========================================================
       【系統參數配置區】
       可在此修改 Google 試算表 CSV 網址與輪播間隔秒數
       ========================================================= */
    const CONFIG = {
      // Google 試算表發佈的 CSV 網址
      csvUrl: 'https://docs.google.com/spreadsheets/d/e/2PACX-1vR0ldDkH7bJVUGSihnCSI9Lxias1hAJNRuw-NcGo2TIKvlHFFxnd7tnqBFC1Ci9RM0qajlMSkPZtLhb/pub?output=csv',
      
      // 【輪播秒數控制】控制每幾毫秒換下一個卡片亮起 (3000 ms = 3 秒)
      carouselInterval: 3000 
    };

    let cardsData = [];      // 存放解析後的留言陣列
    let currentIndex = 0;    // 當前高亮的卡片索引
    let timer = null;        // setInterval 計時器參考

    /* =========================================================
       1. CSV 解析器 (Robust CSV Parser)
       處理雙引號、留言內容包含逗號 (,) 與換行符號的情形
       ========================================================= */
    function parseCSV(text) {
      const lines = [];
      let row = [];
      let currentField = '';
      let inQuotes = false;

      for (let i = 0; i < text.length; i++) {
        const char = text[i];
        const nextChar = text[i + 1];

        if (char === '"') {
          if (inQuotes && nextChar === '"') {
            currentField += '"'; // 處理雙重雙引號 (轉義)
            i++;
          } else {
            inQuotes = !inQuotes; // 切換雙引號開關狀態
          }
        } else if (char === ',' && !inQuotes) {
          row.push(currentField.trim());
          currentField = '';
        } else if ((char === '\r' || char === '\n') && !inQuotes) {
          if (char === '\r' && nextChar === '\n') {
            i++; // 處理 Windows 式換行 (\r\n)
          }
          row.push(currentField.trim());
          if (row.length > 1 || row[0] !== '') {
            lines.push(row);
          }
          row = [];
          currentField = '';
        } else {
          currentField += char;
        }
      }
      
      if (currentField || row.length > 0) {
        row.push(currentField.trim());
        lines.push(row);
      }

      return lines;
    }

    /* =========================================================
       2. 讀取 Google 試算表 CSV 資料
       ========================================================= */
    async function fetchMessages() {
      const loadingEl = document.getElementById('loading');
      
      try {
        const response = await fetch(CONFIG.csvUrl);
        if (!response.ok) throw new Error('網路回應不正常');
        
        const csvText = await response.text();
        const parsedRows = parseCSV(csvText);

        // 假設第一列是標題 (時間戳記, 名字, 悄悄話)，我們從 index 1 開始取資料
        // CSV 欄位順序預設： [0]時間戳記, [1]名字, [2]悄悄話
        cardsData = parsedRows.slice(1).map(row => ({
          timestamp: row[0] || '',
          name: row[1] || '無名氏',
          content: row[2] || '（這張卡片沒有留下文字～）'
        })).filter(item => item.name !== '無名氏' || item.content !== ''); // 移除空行

        // 隱藏 Loading 動畫
        loadingEl.style.display = 'none';

        // 動態生成 HTML 卡片牆
        renderCards(cardsData);

        // 資料渲染完畢後，啟動自動輪播特效
        if (cardsData.length > 0) {
          startCarousel();
        }

      } catch (error) {
        console.error('讀取留言時發生錯誤：', error);
        loadingEl.innerHTML = '<p style="color: #FF4D4D;">讀取留言失敗，請確認網路連線或試算表網址！😭</p>';
      }
    }

    /* =========================================================
       3. 動態渲染 DOM (卡片牆)
       ========================================================= */
    function renderCards(data) {
      const wall = document.getElementById('masonry-wall');
      wall.innerHTML = '';

      data.forEach((item, index) => {
        const cardNode = document.createElement('div');
        cardNode.className = 'card';
        cardNode.dataset.index = index;

        // 格式化時間戳記 (僅保留日期部分簡化顯示)
        let formattedTime = item.timestamp;
        if (item.timestamp.includes(' ')) {
          formattedTime = item.timestamp.split(' ')[0]; // 只取日期
        }

        cardNode.innerHTML = `
          <div class="card-header">
            <span class="card-name">🍬 ${escapeHTML(item.name)}</span>
            <span class="card-time">${escapeHTML(formattedTime)}</span>
          </div>
          <div class="card-content">${escapeHTML(item.content)}</div>
        `;

        // 點擊卡片時，可手動將焦點切換到該卡片
        cardNode.addEventListener('click', () => {
          currentIndex = index;
          highlightCard(currentIndex);
          resetCarouselTimer(); // 重置計時器，避免手動點擊後立刻被自動輪播跳走
        });

        wall.appendChild(cardNode);
      });
    }

    /* XSS 防護：簡單的轉義字元函式 */
    function escapeHTML(str) {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    /* =========================================================
       4. 卡片亮起 (Highlight) 輪播機制
       ========================================================= */
    function highlightCard(index) {
      const wall = document.getElementById('masonry-wall');
      const cards = document.querySelectorAll('.card');

      if (cards.length === 0) return;

      // 告訴父容器「現在有卡片高亮中」，以利觸發非高亮卡片的暗化/模糊 CSS
      wall.classList.add('has-highlight');

      // 移除所有卡片的 highlight 類別
      cards.forEach(card => card.classList.remove('highlight'));

      // 為當前目標卡片加上 highlight
      const targetCard = cards[index];
      if (targetCard) {
        targetCard.classList.add('highlight');
        
        // 可選功能：若是長網頁，可自動滾動將卡片移至可視範圍 (視需要開啟)
        // targetCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    // 啟動自動輪播計時器
    function startCarousel() {
      // 立即執行第一次高亮
      highlightCard(currentIndex);

      // 設定每 CONFIG.carouselInterval (預設 3000ms) 切換一次
      timer = setInterval(() => {
        currentIndex = (currentIndex + 1) % cardsData.length; // 循環播放
        highlightCard(currentIndex);
      }, CONFIG.carouselInterval);
    }

    // 重置計時器 (手動點擊卡片後調用)
    function resetCarouselTimer() {
      if (timer) clearInterval(timer);
      startCarousel();
    }

    /* =========================================================
       5. 程式進入點 (DOM 載入完成後執行)
       ========================================================= */
    document.addEventListener('DOMContentLoaded', fetchMessages);
  </script>
</body>
</html>
